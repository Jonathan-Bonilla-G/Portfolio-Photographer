cat > .gitignore << 'EOF'
# ==========================
# Sistema Operativo
# ==========================
.DS_Store

# ==========================
# Editor de código
# ==========================
.vscode/

# ==========================
# Archivos de registro
# ==========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================
# Dependencias
# ==========================
node_modules/

# ==========================
# Variables de entorno
# ==========================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
